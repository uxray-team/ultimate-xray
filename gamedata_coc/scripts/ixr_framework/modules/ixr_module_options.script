
--[[
	IX-Ray Module Options
	Version: 1.0
	Author: FFx0001
	Script: ixr_module_options.script
	Description: Module for centralized configure scripts options in main menu
	
	Public exports:
		get_module_info()
		init()
		is_initialized()
]]


-- black_option_rounded_rect_selected

-- addon_background_selected

local USE_FILE_LOG = true
local USE_CONSOLE_LOG = false
local USE_TIME_IN_LOGS = true

local APPDATA_ALIAS = '$app_data_root$'
local OPTIONS_FILE_NAME = "ixr_options.ixr"
local DRAW_VAR_NAME = false

local CONST_APPDATA_FOLDER = nil -- auto
local options_scroll_wnd = nil

ixr_options = {
	options = {},
	options_addon_info = {},
	options_storage = {},
	options_storage_loaded = false,
	initialized = false,
	use_file_log = USE_FILE_LOG,
	use_time_log = USE_TIME_IN_LOGS,
	use_console_log = USE_CONSOLE_LOG,
	_counter = 0,
	__timer = 0,
}

function getOptions()
	return ixr_options.options or {}
end

function getOptionsAddonInfo()
	return ixr_options.options_addon_info or {}
end

-- #######################################
-- #	 	 	CALLBACKS				 #
-- #######################################
function on_game_start()	
	_load_options()
end

-- #######################################
-- #	 	 PUBLIC METHODS 	  	 	 #
-- #######################################

--[[
Description: Module management. Returns metadata about the module.
Return: (table) - A table containing module information such as alias name, category, version, authors, and description.
]]
function get_module_info()
	return {
		-- (string) constant module name independent of the script name, which will be centralized via ixr_framework.get_module("alias_name") to maintain module versioning without the need to access the script name during integration.
		alias_name = "ixr_options",
		
		-- (string) use once value at range or custom latin snake case name default categories: ["ixr_system", "sub_system", "sub_gameplay", "sub_utils"] use for ordering init calls at 1 to last ASC
		category = "ixr_system",
		
		-- (float) value for controll versions
		version = 1.0,
		
		-- (string) public exposed function name, allowed in this script for auto init module
		init_function_name = "init",
		
		-- (string|string[]) code author(s) nick name(s)
		authors = "FFx0001",
		
		-- (string) short description about module
		description = "Module for centralized configure scripts options in main menu",
	}
end

--[[
Description: Initializes the module and sets up necessary configurations.
Return: (bool) - Returns true if the module was successfully initialized.
]]
function init()
	return ixr_options.init()
end

--[[
Description: Checks whether the module has been initialized.
Return: (bool) - Returns true if the module is initialized, otherwise false.
]]
function is_initialized()
	return ixr_options.is_initialized()
end

--[[
Description: Check has option by name exists
Return: (bool)
]]
function has_variable_value(var_name)
	local script_name = ffx_callable_utils.find_caller_source(3)
	
	return ixr_options.has_variable_value(script_name, var_name)
end

--[[
Description: Get option value by name is exists or default
Return: (nil|bool|int|float|string|table|function)
]]
function get_variable_value(var_name, default_value)
	local script_name = ffx_callable_utils.find_caller_source(3)

	return ixr_options.get_variable_value(script_name, var_name, default_value)
end

--local metadata = ixr_options.get_metadata(self.script_name, self.variable_name)

--[[
Description: Set option value by name is exists
Return: (nil|bool|int|float|string|table|function)
]]
function set_variable_value(var_name, var_value)
	local script_name = ffx_callable_utils.find_caller_source(3)
	
	local metadata = ixr_options.get_metadata(script_name, var_name)
	
	metadata.update_visual_value = var_value
	ixr_options.set_metadata(script_name, var_name, metadata)
	
	return ixr_options.set_variable_value(script_name, var_name, var_value)
end

--[[
Description: Set option visible state by name is exists
Return: (nil|bool|int|float|string|table|function)
]]
function set_visible_option(var_name, visible)
	local script_name = ffx_callable_utils.find_caller_source(3)
	local metadata = ixr_options.get_metadata(script_name, var_name)
	
	metadata.visible_controlls = visible
	
	ixr_options.set_metadata(script_name, var_name, metadata)
	
	return ixr_options.set_variable_value(script_name, var_name, var_value)
end

function set_options_title(title_text)
	local script_name = ffx_callable_utils.find_caller_source(3)
	if ixr_options.options_addon_info[script_name] == nil then
		ixr_options.options_addon_info[script_name] = {}
	end
	
	ixr_options.options_addon_info[script_name]["options_title"] = title_text
end

