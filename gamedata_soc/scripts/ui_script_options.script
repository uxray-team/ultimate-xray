
-- #########################################################################################################
-- 												TRACK BAR
-- #########################################################################################################
class "IXRTrackBar" (CUIStatic)
function IXRTrackBar:__init(parent, shell, default_value, min_value, max_value, value_offset, use_ceil, _callback, script_name, variable_name)
	super()
	
	self.parent = parent
	self.script_visible_controlls = nil
	
	self.is_pushed_from_code = false
	self.script_name = script_name
	self.variable_name = variable_name
	
	self.use_ceil = use_ceil
	self.visible = false
	self.value = 0.0
	
	self.on_change_callback = _callback
	
	if use_ceil then
		self.controll_track_bar = parent.xml:InitTrackBar("main_dialog:track_template_int", shell)
		self.controll_track_bar:SetOptIBounds(min_value, max_value)
	else
		self.controll_track_bar = parent.xml:InitTrackBar("main_dialog:track_template_float", shell)
		self.controll_track_bar:SetOptFBounds(min_value, max_value)
	end
	
	self.controll_track_bar:SetStep(value_offset)
	parent:AddCallback(self.controll_track_bar, ui_events.TRACK_VALUE_CHANGED, self.OnChangeState, parent)
	
	if use_ceil then
		self.controll_track_bar:SetIValue(default_value)
	else
		self.controll_track_bar:SetFValue(default_value)
	end
	self:Show(true)
end

function IXRTrackBar:Show(flag, skip_callbacks)
	if skip_callbacks == nil then 
		skip_callbacks = false
	end
	
	self.visible = flag
	self.controll_track_bar:Show(flag)
	
	if not skip_callbacks then
		if flag then
			self:OnChangeState()
			self.parent.updateBus[self] = function () self:Update() end
		else
			self.parent.updateBus[self] = nil
		end
	end
end

function IXRTrackBar:Update()
	local metadata = GetModule("ixr_module_options").ixr_options.get_metadata(self.script_name, self.variable_name)
	self:UpdateVisualValue(metadata)
	self:UpdateControllVisibility(metadata)
end

function IXRTrackBar:UpdateControllVisibility(metadata)
	if metadata ~= nil and self.script_visible_controlls ~= metadata.visible_controlls then
		self.script_visible_controlls = metadata.visible_controlls
		self:Show(metadata.visible_controlls, true)
	end
end


function IXRTrackBar:UpdateVisualValue(metadata)
	if metadata ~= nil and metadata.update_visual_value ~= nil then
		local new_value = metadata.update_visual_value
		metadata.update_visual_value = nil
		GetModule("ixr_module_options").ixr_options.set_metadata(self.script_name, self.variable_name, metadata)
		
		self:OnIncomingUpdateVisualValue(new_value)
		self.value = self.controll_track_bar:GetFValue()
	end
end

function IXRTrackBar:OnIncomingUpdateVisualValue(new_value_index)
	if self.value == new_value_index then
		return
	end
	
	self.is_pushed_from_code = true
	if use_ceil then
		self.controll_track_bar:SetIValue(new_value_index)
	else
		self.controll_track_bar:SetFValue(new_value_index)
	end
end

function IXRTrackBar:OnChangeState()
	if self.visible and self.on_change_callback then
		if self.use_ceil then
			self.on_change_callback(math.ceil(self.value), self.controll_name, self.is_pushed_from_code)
		else
			self.on_change_callback(self.value, self.controll_name, self.is_pushed_from_code)
		end
	end
	self.is_pushed_from_code = false
end

class "AddonItem" (CUIListBoxItem)

function AddonItem:__init(parent, script_name, options_variables, addon_info) super()	
	self.option_title = game.translate_string(addon_info.options_title) or addon_info.options_title
	self.icon_path = "ui\\ixr_options\\icons\\addon_icon"
	
	if addon_info.icon_path ~= nil then
		self.icon_path = addon_info.icon_path
	end
	
	self.options_addon_name = addon_name
	if addon_info.options_addon_name ~= nil then
		self.options_addon_name =  game.translate_string(tostring(addon_info.options_addon_name)) or tostring(addon_info.options_addon_name)
	end
	
	self.options_script_version = addon_version
	if addon_info.options_script_version ~= nil then
		self.options_script_version = tostring(addon_info.options_script_version)
	end
	
	
	self.options_authors_text = addon_authors
	if addon_info.options_authors_text ~= nil then
		self.options_authors_text = tostring(addon_info.options_authors_text)
	end
	
	self.addon_script_name = script_name
	self.options_variables = options_variables
	
	self.addon_icon = parent.xml:InitStatic("addon_item:icon", self)
	self.addon_icon:InitTexture(self.icon_path)
	
	if addon_info.options_title ~= nil then
		self.addon_title = parent.xml:InitStatic("addon_item:title", self)
		self.addon_title:SetText(self.option_title)
	end
	
	self.script_name = parent.xml:InitStatic("addon_item:script_name", self)
	self.script_name:SetText("Script: " .. self.addon_script_name)
	
	self.addon_status = parent.xml:InitStatic("addon_item:addon_name", self)
	self.addon_status:SetText("Addon: " .. self.options_addon_name)
	
	self.addon_version = parent.xml:InitStatic("addon_item:addon_version", self)
	self.addon_version:SetText("Version: " .. self.options_script_version)
	
	self.addon_authors = parent.xml:InitStatic("addon_item:addon_authors", self)
	self.addon_authors:SetText("Authors: " .. tostring(self.options_authors_text))
end

class "script_options_dialog" (CUIScriptWnd)

function script_options_dialog:__init() super()
	self.focusList = {}
	self.focusIndex = 1
	
	self.updateBus = {}
	self.updateTimer = 0
	
	self.optionsScrollShown = false
    self:InitControls()
    self:InitCallBacks()
	
	action_repeaters():Register(self, key_bindings.kUI_UP, 0, 0)
	action_repeaters():Register(self, key_bindings.kUI_DOWN, 0, 0)
	action_repeaters():Register(self, key_bindings.kUI_LEFT, 0, 0)
	action_repeaters():Register(self, key_bindings.kUI_RIGHT, 0, 0)
end

function script_options_dialog:__finalize()
	action_repeaters():UnregisterOwner(self)
end

function script_options_dialog:InitControls()
	self:SetWndRect				(Frect():set(0,0,1024,768))
	self:Enable					(true)

	self.xml					= CScriptXmlInit()
	self.xml:ParseFile			("ui_mm_script_options.xml")

	self.xml:InitStatic			("background", self)
	self.dialog					= self.xml:InitStatic("main_dialog:dialog", self)

	self.xml:InitFrame			("main_dialog:list_frame",self.dialog)

	self.list_box				= self.xml:InitListBox("main_dialog:list",self.dialog)
	self.list_box:ShowSelectedItem(true)
	self:Register				(self.list_box, "list_window")

	self.options_scroll			= self.xml:InitScrollView("main_dialog:options_scroll",self.dialog)
	self:Register				(self.options_scroll, "options_scroll")

	self.btn_exit 				= self.xml:Init3tButton("main_dialog:btn_exit", self.dialog)
	self:Register				(self.btn_exit, "btn_exit")
	
	self.btn_save 				= self.xml:Init3tButton("main_dialog:btn_save", self.dialog)
	self:Register				(self.btn_save, "btn_save")
	
	self.btn_back 				= self.xml:Init3tButton("main_dialog:btn_back", self.dialog)
	self:Register				(self.btn_back, "btn_back")
end

function script_options_dialog:InitCallBacks()
	self:AddCallback("btn_exit",			ui_events.BUTTON_CLICKED,		self.OnBtnExit,			self)
	self:AddCallback("btn_back",			ui_events.BUTTON_CLICKED,		self.OnBtnBack,			self)
	self:AddCallback("list_window", 		ui_events.LIST_ITEM_CLICKED, 	self.OnListItemClicked,	self)
end

function script_options_dialog:add_option_shell(fn_fillable)
	local shell = self.xml:InitStatic("main_dialog:templ_item", nil)
	
	if fn_fillable ~= nil then
		fn_fillable(shell)
	end
	
	self.options_scroll:AddWindow(shell, false)
	self.options_scroll:SetAutoDelete(false)
	
	return shell
end

